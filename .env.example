# Server settings for docker-compose.prod.yml. deploy/publish.sh expects this file on the
# Pi, next to the compose file ($PI_DIR/.env, default ~/relentlessbadger/.env); create it
# there once. It never leaves the Pi. (.env is gitignored.)

# PostgreSQL password (also embedded in the API's connection string).
POSTGRES_PASSWORD=

# JWT signing key — generate one with: openssl rand -base64 48
JWT_KEY=

# Google OAuth *Web* client ID (same value as BADGER_GOOGLE_WEB_CLIENT_ID in the
# app build and GOOGLE_WEB_CLIENT_ID in deploy/deploy.env; see the README's OAuth
# section). Required in practice: the dev sign-in bypass only exists in Development.
GOOGLE_CLIENT_ID=

# Extra origin allowed to call the API from a browser. Leave empty: the web app is
# served from the same origin as the API (https://<pi>/badger → /badger-api), so it
# needs no CORS. Only set it for a web app hosted somewhere else.
WEB_ORIGIN=

# Host folder the database dumps from deploy/backup.sh land in (mounted into the
# Postgres container at /backups). Relative paths are relative to this file.
#BACKUP_DIR=./backups

# Optional: images to run instead of the ones deploy/publish.sh ships.
#API_IMAGE=
#WEB_IMAGE=
