<resources>
    <!-- Dark parent so the window background shown before Compose draws its
         first frame matches the dark color scheme instead of flashing white. -->
    <style name="Theme.RelentlessBadger" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
