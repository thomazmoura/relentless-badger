<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system bar icon appearance is set from BadgerTheme, which knows
         whether the app is drawing a light or a dark background. -->
    <style name="Theme.RelentlessBadger" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
