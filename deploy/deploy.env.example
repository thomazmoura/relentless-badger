# Settings for deploy/publish.sh and deploy/backup.sh, run from your dev machine. Copy to
# deploy/deploy.env (gitignored) or export them; exported variables win over this file.
# Secrets for the server itself (POSTGRES_PASSWORD, JWT_KEY, …) live in the Pi's own .env
# instead — see .env.example — and never leave the Pi.

# ssh target. The Tailscale name works as long as this machine is on the tailnet.
PI_HOST=badgerpi.tail1234.ts.net
#PI_USER=pi
#PI_PORT=22
#PI_SSH_KEY=~/.ssh/id_ed25519

# The Pi's Tailscale MagicDNS name: the HTTPS certificate is issued for it and the app is
# served at https://<it>/badger. Defaults to PI_HOST.
#PI_TS_HOSTNAME=badgerpi.tail1234.ts.net

# Where the stack and the shared gateway live on the Pi (relative to the ssh user's home).
#PI_DIR=relentlessbadger
#GATEWAY_DIR=gateway

# Image architecture: linux/arm64 for a 64-bit Raspberry Pi OS.
#PI_PLATFORM=linux/arm64

# Google OAuth *Web* client ID baked into the web build (same value as GOOGLE_CLIENT_ID in
# the Pi's .env). Empty = the web app offers the dev sign-in instead.
#GOOGLE_WEB_CLIENT_ID=

# Number of database dumps to keep in the backups folder.
#BACKUP_KEEP=14

# 1 = don't take a backup before publishing (migrations run on every publish).
#SKIP_BACKUP=0
